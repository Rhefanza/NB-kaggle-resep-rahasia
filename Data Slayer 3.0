{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.11.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"gpu","dataSources":[{"sourceId":13865249,"sourceType":"datasetVersion","datasetId":8833685}],"dockerImageVersionId":31193,"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":true}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import warnings\nwarnings.filterwarnings(\"ignore\")\nimport pandas as pd\nimport os\nimport cv2\nimport random\nimport numpy as np\nimport pandas as pd\n\nfrom PIL import Image\nfrom tqdm import tqdm\n\nimport torch\nimport torch.nn as nn\nfrom torch.utils.data import Dataset, DataLoader\nimport torchvision.transforms as T\nimport timm\n\nfrom sklearn.metrics import f1_score, classification_report","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:21:10.042796Z","iopub.execute_input":"2025-11-26T11:21:10.043374Z","iopub.status.idle":"2025-11-26T11:21:20.864068Z","shell.execute_reply.started":"2025-11-26T11:21:10.043347Z","shell.execute_reply":"2025-11-26T11:21:20.863480Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"BASE_DIR = \"/kaggle/input/data-slayer\"\nTRAIN_DIR = os.path.join(BASE_DIR, \"train\")\nTEST_DIR  = os.path.join(BASE_DIR, \"test\")\nSAMPLE_SUB_PATH = os.path.join(BASE_DIR, \"sample_submission.csv\")\n\nprint(\"BASE_DIR:\", BASE_DIR)\nprint(\"Isi BASE_DIR:\", os.listdir(BASE_DIR))\nprint(\"Isi TRAIN_DIR:\", os.listdir(TRAIN_DIR))\nprint(\"Contoh TEST_DIR:\", os.listdir(TEST_DIR)[:5])\n\nSEED = 42\n\ndef set_seed(seed=SEED):\n    random.seed(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    if torch.cuda.is_available():\n        torch.cuda.manual_seed_all(seed)\n\nset_seed(SEED)\n\ndevice = \"cuda\" if torch.cuda.is_available() else \"cpu\"\nprint(\"Device:\", device)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:21:20.865081Z","iopub.execute_input":"2025-11-26T11:21:20.865529Z","iopub.status.idle":"2025-11-26T11:21:21.099112Z","shell.execute_reply.started":"2025-11-26T11:21:20.865508Z","shell.execute_reply":"2025-11-26T11:21:21.098479Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"video_rows = []\n\nfor cls_name in [\"drowsiness\", \"non-drowsiness\"]:\n    cls_dir = os.path.join(TRAIN_DIR, cls_name)\n    label = 1 if cls_name == \"drowsiness\" else 0\n    \n    subjects = sorted(os.listdir(cls_dir))\n    for subj in subjects:\n        subj_dir = os.path.join(cls_dir, subj)\n        if not os.path.isdir(subj_dir):\n            continue\n        \n        for fname in sorted(os.listdir(subj_dir)):\n            if not fname.lower().endswith((\".mp4\", \".avi\", \".mov\", \".mkv\")):\n                continue\n            fp = os.path.join(subj_dir, fname)\n            name_l = fname.lower()\n            \n            # parsing behavior\n            if \"microsleep\" in name_l:\n                behavior = \"microsleep\"\n            elif \"yawning\" in name_l:\n                behavior = \"yawning\"\n            elif \"focus\" in name_l:\n                behavior = \"focus\"\n            elif \"talking\" in name_l:\n                behavior = \"talking\"\n            else:\n                behavior = \"unknown\"\n            \n            # parsing angle\n            if \"front\" in name_l:\n                angle = \"front\"\n            elif \"side\" in name_l:\n                angle = \"side\"\n            else:\n                angle = \"unknown\"\n            \n            video_rows.append({\n                \"class\": cls_name,\n                \"label\": label,\n                \"subject\": subj,\n                \"behavior\": behavior,\n                \"angle\": angle,\n                \"video_path\": fp,\n            })\n\nvideo_df = pd.DataFrame(video_rows)\nprint(\"Jumlah video:\", len(video_df))\ndisplay(video_df.head())\ndisplay(video_df[\"subject\"].value_counts())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:22:25.840345Z","iopub.execute_input":"2025-11-26T11:22:25.840849Z","iopub.status.idle":"2025-11-26T11:22:26.760139Z","shell.execute_reply.started":"2025-11-26T11:22:25.840826Z","shell.execute_reply":"2025-11-26T11:22:26.759584Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"FRAME_ROOT = \"/kaggle/working/train_frames\"\nos.makedirs(FRAME_ROOT, exist_ok=True)\n\ndef extract_frames(video_path, out_dir):\n    os.makedirs(out_dir, exist_ok=True)\n    cap = cv2.VideoCapture(video_path)\n    idx = 0\n    frame_paths = []\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        fp = os.path.join(out_dir, f\"frame_{idx:05d}.jpg\")\n        cv2.imwrite(fp, frame)\n        frame_paths.append(fp)\n        idx += 1\n    cap.release()\n    return frame_paths\n\nall_clips = []\n\nfor i, row in tqdm(video_df.iterrows(), total=len(video_df)):\n    vp   = row[\"video_path\"]\n    subj = row[\"subject\"]\n    angle = row[\"angle\"]\n    behavior = row[\"behavior\"]\n    cls = row[\"class\"]\n    label = row[\"label\"]\n\n    out_dir = os.path.join(FRAME_ROOT, cls, subj, f\"{angle}_{behavior}\")\n    frame_paths = extract_frames(vp, out_dir)\n    num_frames = len(frame_paths)\n\n    all_clips.append({\n        \"class\": cls,\n        \"label\": label,\n        \"subject\": subj,\n        \"angle\": angle,\n        \"behavior\": behavior,\n        \"frames_dir\": out_dir,\n        \"num_frames\": num_frames,\n    })\n\nclips_df = pd.DataFrame(all_clips)\nprint(\"Jumlah clip (video) yang diekstrak:\", len(clips_df))\ndisplay(clips_df.head())\ndisplay(clips_df[[\"class\",\"subject\",\"behavior\",\"num_frames\"]].head(10))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:22:44.415519Z","iopub.execute_input":"2025-11-26T11:22:44.415806Z","iopub.status.idle":"2025-11-26T11:30:25.041635Z","shell.execute_reply.started":"2025-11-26T11:22:44.415783Z","shell.execute_reply":"2025-11-26T11:30:25.041027Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"FPS = 30\nFRAMES_PER_SEQ = 30\nT_START_EVENT = 6   # detik\nT_END_MARGIN = 2    # detik\n\ndef get_event_range(num_frames):\n    # indeks kasar berdasarkan detik\n    start_idx = int(T_START_EVENT * FPS)\n    end_trim  = int(T_END_MARGIN * FPS)\n    # jaga-jaga kalau durasi pendek\n    if num_frames <= FRAMES_PER_SEQ:\n        return 0, num_frames\n    start_idx = min(start_idx, num_frames - FRAMES_PER_SEQ)\n    end_idx   = num_frames - end_trim\n    end_idx   = max(end_idx, start_idx + FRAMES_PER_SEQ)\n    return start_idx, end_idx\n\nseq_rows = []\nseq_id_counter = 0\n\nfor i, row in clips_df.iterrows():\n    num_frames = row[\"num_frames\"]\n    frames_dir = row[\"frames_dir\"]\n    label      = row[\"label\"]\n\n    if num_frames < FRAMES_PER_SEQ:\n        continue  # video terlalu pendek, skip\n\n    if label == 1:       # drowsy → zona event\n        start_idx, end_idx = get_event_range(num_frames)\n    else:                # non-drowsy → full\n        start_idx, end_idx = 0, num_frames\n\n    for s in range(start_idx, end_idx - FRAMES_PER_SEQ + 1, FRAMES_PER_SEQ):\n        seq_id_counter += 1\n        seq_rows.append({\n            \"seq_id\": f\"train_seq_{seq_id_counter:06d}\",\n            \"subject\":  row[\"subject\"],\n            \"class\":    row[\"class\"],\n            \"angle\":    row[\"angle\"],\n            \"behavior\": row[\"behavior\"],\n            \"frames_dir\": frames_dir,\n            \"start_frame\": s,\n            \"label\": label,\n        })\n\nseq_df = pd.DataFrame(seq_rows)\nprint(\"Total sequence:\", len(seq_df))\ndisplay(seq_df.head())\nprint(\"Distribusi label keseluruhan:\\n\", seq_df[\"label\"].value_counts())\nprint(\"Subjects:\", sorted(seq_df[\"subject\"].unique()))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:06.447132Z","iopub.execute_input":"2025-11-26T11:33:06.447959Z","iopub.status.idle":"2025-11-26T11:33:06.484276Z","shell.execute_reply.started":"2025-11-26T11:33:06.447936Z","shell.execute_reply":"2025-11-26T11:33:06.483556Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"subjects = sorted(seq_df[\"subject\"].unique())\nprint(\"Subjects:\", subjects)\n\n# contoh: 3 subject terakhir valid\nif len(subjects) >= 3:\n    valid_subjects = subjects[-3:]\nelse:\n    valid_subjects = subjects[-1:]  # fallback kalau sedikit\ntrain_subjects = [s for s in subjects if s not in valid_subjects]\n\nprint(\"Train subjects:\", train_subjects)\nprint(\"Valid subjects:\", valid_subjects)\n\ntrain_seq_df = seq_df[seq_df[\"subject\"].isin(train_subjects)].reset_index(drop=True)\nvalid_seq_df = seq_df[seq_df[\"subject\"].isin(valid_subjects)].reset_index(drop=True)\n\nprint(\"Train sequences:\", len(train_seq_df))\nprint(\"Valid sequences:\", len(valid_seq_df))\nprint(\"Train label dist:\\n\", train_seq_df[\"label\"].value_counts())\nprint(\"Valid label dist:\\n\", valid_seq_df[\"label\"].value_counts())","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:11.932686Z","iopub.execute_input":"2025-11-26T11:33:11.933424Z","iopub.status.idle":"2025-11-26T11:33:11.945377Z","shell.execute_reply.started":"2025-11-26T11:33:11.933398Z","shell.execute_reply":"2025-11-26T11:33:11.944657Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from PIL import Image\n\n# koordinat crop (x1, y1, x2, y2) untuk resolusi 1280x720\n# tweak kalau perlu, atau set None untuk disable cropping\nFACE_CROP = (350, 80, 950, 650)\n\ndef crop_face_pil(img, crop_box=FACE_CROP):\n    if crop_box is None:\n        return img\n    \n    x1, y1, x2, y2 = crop_box\n    w, h = img.size\n    \n    x1 = max(0, x1); y1 = max(0, y1)\n    x2 = min(w, x2); y2 = min(h, y2)\n    \n    return img.crop((x1, y1, x2, y2))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:19.893121Z","iopub.execute_input":"2025-11-26T11:33:19.893867Z","iopub.status.idle":"2025-11-26T11:33:19.898360Z","shell.execute_reply.started":"2025-11-26T11:33:19.893843Z","shell.execute_reply":"2025-11-26T11:33:19.897630Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"IMG_SIZE = 160\nFRAMES_PER_SEQ = 30\n\ntrain_tf = T.Compose([\n    T.Resize((IMG_SIZE, IMG_SIZE)),\n    T.RandomHorizontalFlip(),\n    T.ColorJitter(brightness=0.2, contrast=0.2),\n    T.ToTensor(),\n    T.Normalize(mean=[0.485, 0.456, 0.406],\n                std =[0.229, 0.224, 0.225]),\n])\n\neval_tf = T.Compose([\n    T.Resize((IMG_SIZE, IMG_SIZE)),\n    T.ToTensor(),\n    T.Normalize(mean=[0.485, 0.456, 0.406],\n                std =[0.229, 0.224, 0.225]),\n])\n\nclass TrainFrameDataset(Dataset):\n    \"\"\"1 sample = 1 frame random dari 1 sequence (hemat GPU).\"\"\"\n    def __init__(self, df, transform, frames_per_seq=FRAMES_PER_SEQ):\n        self.df = df.reset_index(drop=True)\n        self.transform = transform\n        self.frames_per_seq = frames_per_seq\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        frames_dir = row[\"frames_dir\"]\n        start = row[\"start_frame\"]\n        label = torch.tensor(row[\"label\"], dtype=torch.float32)\n\n        # pilih 1 frame random dari 30 frame\n        offset = random.randint(0, self.frames_per_seq - 1)\n        frame_idx = start + offset\n        fp = os.path.join(frames_dir, f\"frame_{frame_idx:05d}.jpg\")\n\n        img = Image.open(fp).convert(\"RGB\")\n        img = crop_face_pil(img)\n        img = self.transform(img)\n        return img, label\n\n\nclass SequenceDataset(Dataset):\n    \"\"\"1 sample = 30 frame lengkap untuk 1 sequence (eval).\"\"\"\n    def __init__(self, df, transform, frames_per_seq=FRAMES_PER_SEQ):\n        self.df = df.reset_index(drop=True)\n        self.transform = transform\n        self.frames_per_seq = frames_per_seq\n\n    def __len__(self):\n        return len(self.df)\n\n    def __getitem__(self, idx):\n        row = self.df.iloc[idx]\n        frames_dir = row[\"frames_dir\"]\n        start = row[\"start_frame\"]\n        label = torch.tensor(row[\"label\"], dtype=torch.float32)\n\n        imgs = []\n        for i in range(self.frames_per_seq):\n            fp = os.path.join(frames_dir, f\"frame_{start + i:05d}.jpg\")\n            img = Image.open(fp).convert(\"RGB\")\n            img = crop_face_pil(img)\n            img = self.transform(img)\n            imgs.append(img)\n\n        frames = torch.stack(imgs, dim=0)  # [T, C, H, W]\n        return frames, label","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:23.896842Z","iopub.execute_input":"2025-11-26T11:33:23.897111Z","iopub.status.idle":"2025-11-26T11:33:23.907445Z","shell.execute_reply.started":"2025-11-26T11:33:23.897093Z","shell.execute_reply":"2025-11-26T11:33:23.906734Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"BATCH_SIZE = 16\n\ntrain_ds = TrainFrameDataset(train_seq_df, train_tf)\nvalid_ds = SequenceDataset(valid_seq_df, eval_tf)\n\ntrain_loader = DataLoader(\n    train_ds, batch_size=BATCH_SIZE,\n    shuffle=True, num_workers=0\n)\n\nvalid_loader = DataLoader(\n    valid_ds, batch_size=1,\n    shuffle=False, num_workers=0\n)\n\nprint(\"Len train_ds:\", len(train_ds))\nprint(\"Len valid_ds:\", len(valid_ds))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:29.044061Z","iopub.execute_input":"2025-11-26T11:33:29.044700Z","iopub.status.idle":"2025-11-26T11:33:29.050100Z","shell.execute_reply.started":"2025-11-26T11:33:29.044676Z","shell.execute_reply":"2025-11-26T11:33:29.049373Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"class EffNetB0Binary(nn.Module):\n    def __init__(self, pretrained=True):\n        super().__init__()\n        self.backbone = timm.create_model(\n            \"efficientnet_b0\",\n            pretrained=pretrained,\n            num_classes=0,   # ambil fitur saja\n            global_pool=\"avg\"\n        )\n        self.classifier = nn.Sequential(\n            nn.Dropout(p=0.3),\n            nn.Linear(self.backbone.num_features, 1)\n        )\n\n    def forward(self, x):  # x: [B, 3, H, W]\n        feats = self.backbone(x)         # [B, F]\n        logits = self.classifier(feats)  # [B, 1]\n        return logits.squeeze(1)         # [B]\n\nmodel = EffNetB0Binary(pretrained=True).to(device)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:35.051106Z","iopub.execute_input":"2025-11-26T11:33:35.052155Z","iopub.status.idle":"2025-11-26T11:33:37.546808Z","shell.execute_reply.started":"2025-11-26T11:33:35.052129Z","shell.execute_reply":"2025-11-26T11:33:37.546227Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"neg = (train_seq_df[\"label\"] == 0).sum()\npos = (train_seq_df[\"label\"] == 1).sum()\nprint(\"neg:\", neg, \"pos:\", pos, \"ratio neg/pos:\", neg/pos)\n\npos_weight = torch.tensor(neg/pos, device=device)\ncriterion = nn.BCEWithLogitsLoss(pos_weight=pos_weight)\n\noptimizer = torch.optim.AdamW(model.parameters(), lr=1e-4, weight_decay=1e-4)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:41.789383Z","iopub.execute_input":"2025-11-26T11:33:41.789896Z","iopub.status.idle":"2025-11-26T11:33:41.796631Z","shell.execute_reply.started":"2025-11-26T11:33:41.789875Z","shell.execute_reply":"2025-11-26T11:33:41.795991Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"def evaluate(model, loader, threshold=0.5, pooling=\"mean\"):\n    model.eval()\n    all_logits, all_labels = [], []\n    with torch.no_grad():\n        for frames, labels in loader:\n            # frames: [1, T, C, H, W]\n            frames = frames.squeeze(0).to(device)   # [T, C, H, W]\n            labels = labels.to(device)\n\n            logits = model(frames)  # [T]\n\n            if pooling == \"mean\":\n                seq_logit = logits.mean().item()\n            elif pooling == \"max\":\n                seq_logit = logits.max().item()\n            else:\n                seq_logit = logits.mean().item()\n\n            all_logits.append(seq_logit)\n            all_labels.append(labels.item())\n\n    all_logits = np.array(all_logits)\n    all_labels = np.array(all_labels)\n    probs = 1 / (1 + np.exp(-all_logits))\n    preds = (probs >= threshold).astype(int)\n\n    print(classification_report(all_labels, preds, digits=3))\n    f1_macro = f1_score(all_labels, preds, average=\"macro\")\n    return f1_macro, probs, all_labels","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:33:46.415486Z","iopub.execute_input":"2025-11-26T11:33:46.416194Z","iopub.status.idle":"2025-11-26T11:33:46.421921Z","shell.execute_reply.started":"2025-11-26T11:33:46.416169Z","shell.execute_reply":"2025-11-26T11:33:46.421092Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from torch.optim.lr_scheduler import OneCycleLR\n\nEPOCHS = 10\n\n# misal: max_lr 1e-3 (kamu sebelumnya pakai 1e-4,\n# untuk OneCycleLR biasanya max_lr sedikit lebih tinggi)\nmax_lr = 1e-3\n\nscheduler = OneCycleLR(\n    optimizer,\n    max_lr=max_lr,\n    epochs=EPOCHS,\n    steps_per_epoch=len(train_loader)\n)\n\ndef freeze_backbone(model, freeze=True):\n    model.backbone.requires_grad_(not freeze)\n    # classifier tetap trainable\n    model.classifier.requires_grad_(True)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:43:04.731316Z","iopub.execute_input":"2025-11-26T11:43:04.731932Z","iopub.status.idle":"2025-11-26T11:43:04.736755Z","shell.execute_reply.started":"2025-11-26T11:43:04.731909Z","shell.execute_reply":"2025-11-26T11:43:04.735869Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"best_f1 = 0.0\nbest_state = None\n\nfor epoch in range(EPOCHS):\n    # 3 epoch pertama: freeze backbone (hanya latih classifier)\n    if epoch < 3:\n        freeze_backbone(model, freeze=True)\n        print(f\"Epoch {epoch+1}: BACKBONE FROZEN\")\n    else:\n        freeze_backbone(model, freeze=False)\n        print(f\"Epoch {epoch+1}: BACKBONE UNFROZEN\")\n\n    model.train()\n    running_loss = 0.0\n\n    for imgs, labels in train_loader:\n        imgs = imgs.to(device)\n        labels = labels.to(device)\n\n        optimizer.zero_grad()\n        logits = model(imgs)            # [B]\n        loss = criterion(logits, labels)\n        loss.backward()\n        optimizer.step()\n        scheduler.step()                # OneCycleLR update tiap batch\n\n        running_loss += loss.item() * imgs.size(0)\n\n    train_loss = running_loss / len(train_loader.dataset)\n\n    # evaluasi di validation (sequence-level)\n    f1_macro, probs_val, y_val = evaluate(\n        model,\n        valid_loader,\n        threshold=0.5,\n        pooling=\"mean\"  # bisa kamu ganti \"max\" kalau mau eksperimen\n    )\n    current_lr = scheduler.get_last_lr()[0]\n    print(f\"Epoch {epoch+1}: lr={current_lr:.6f}, train_loss={train_loss:.4f}, F1_macro_val={f1_macro:.4f}\")\n\n    if f1_macro > best_f1:\n        best_f1 = f1_macro\n        best_state = {k: v.cpu() for k, v in model.state_dict().items()}\n        print(\">> New best model, F1_macro =\", best_f1)\n\nprint(\"Best F1_macro (val):\", best_f1)\nif best_state is not None:\n    model.load_state_dict(best_state)\n    model.to(device)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-11-26T11:43:19.885575Z","iopub.execute_input":"2025-11-26T11:43:19.886329Z","iopub.status.idle":"2025-11-26T11:44:36.345211Z","shell.execute_reply.started":"2025-11-26T11:43:19.886303Z","shell.execute_reply":"2025-11-26T11:44:36.344241Z"}},"outputs":[],"execution_count":null}]}